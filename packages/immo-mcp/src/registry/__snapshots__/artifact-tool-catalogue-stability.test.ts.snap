      "properties": {
        "artifactId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string",
        },
        "description": {
          "description": "Short artifact description.",
          "maxLength": 2000,
          "type": "string",
        },
        "edits": {
          "description": "Small old/new edits applied to the current release text files; required unless files is supplied.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "newStr": {
                "maxLength": 262144,
                "type": "string",
              },
              "oldStr": {
                "description": "Must occur exactly once in the current file text.",
                "maxLength": 262144,
                "minLength": 1,
                "type": "string",
              },
              "path": {
                "allOf": [
                  {
                    "not": {
                      "pattern": "[\\\\%?#:\\u0000-\\u001f\\u007f]",
                    },
                  },
                  {
                    "not": {
                      "pattern": "(^|/)(\\.\\.?|)(/|$)",
                    },
                  },
                  {
                    "not": {
                      "pattern": "^(?:api|__artifacts|livez|health)(?:/|$)",
                    },
                  },
                ],
                "description": "At most 1024 UTF-8 bytes; no empty/dot segments, colon or DEL.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "path",
              "oldStr",
              "newStr",
            ],
            "type": "object",
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
        "expectedCurrentReleaseId": {
          "description": "Concurrency guard: the currentReleaseId last observed with artifacts_get or artifacts_list (null only for a first publication after a read that returned currentReleaseId null). A missing or stale value is refused with precondition_required.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": [
            "string",
            "null",
          ],
        },
        "files": {
          "description": "Full file set; required unless edits is supplied.",
          "items": {
            "additionalProperties": false,
            "oneOf": [
              {
                "not": {
                  "required": [
                    "bytes",
                  ],
                },
                "required": [
                  "text",
                ],
              },
              {
                "not": {
                  "required": [
                    "text",
                  ],
                },
                "required": [
                  "bytes",
                ],
              },
            ],
            "properties": {
              "bytes": {
                "items": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer",
                },
                "maxItems": 262144,
                "type": "array",
              },
              "mimeType": {
                "enum": [
                  "text/html",
                  "text/css",
                  "text/javascript",
                  "application/json",
                ],
                "type": "string",
              },
              "path": {
                "allOf": [
                  {
                    "not": {
                      "pattern": "[\\\\%?#:\\u0000-\\u001f\\u007f]",
                    },
                  },
                  {
                    "not": {
                      "pattern": "(^|/)(\\.\\.?|)(/|$)",
                    },
                  },
                  {
                    "not": {
                      "pattern": "^(?:api|__artifacts|livez|health)(?:/|$)",
                    },
                  },
                ],
                "description": "At most 1024 UTF-8 bytes; no empty/dot segments, colon or DEL.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string",
              },
              "text": {
                "description": "UTF-8 decoded-byte budget applies.",
                "maxLength": 262144,
                "type": "string",
              },
            },
            "required": [
              "path",
              "mimeType",
            ],
            "type": "object",
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
        },
        "icon": {
          "description": "One short lowercase word.",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": [
            "string",
            "null",
          ],
        },
        "idempotencyKey": {
          "description": "Nonblank by JavaScript trim(); length is UTF-16 units; original bytes retained.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "profile": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null",
            ],
          },
          "default": {},
          "type": "object",
        },
        "title": {
          "description": "Artifact display title.",
          "maxLength": 160,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "artifactId",
        "idempotencyKey",
      ],
      "type": "object",
    },
