      "additionalProperties": false,
      "properties": {
        "bindingName": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "description": {
          "description": "Short artifact description.",
          "maxLength": 2000,
          "type": "string",
        },
        "icon": {
          "description": "One short lowercase word.",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": [
            "string",
            "null",
          ],
        },
        "idempotencyKey": {
          "description": "Nonblank by JavaScript trim(); length is UTF-16 units; original bytes retained.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "parameters": {
          "additionalProperties": false,
          "default": {},
          "properties": {},
          "required": [],
          "type": "object",
        },
        "title": {
          "description": "Artifact display title.",
          "maxLength": 160,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "bindingName",
        "idempotencyKey",
      ],
      "type": "object",
    },
    "name": "artifacts_ensure",
  },
