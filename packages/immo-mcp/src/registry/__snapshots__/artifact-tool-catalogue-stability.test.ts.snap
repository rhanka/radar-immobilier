          "minItems": 1,
          "type": "array",
        },
        "description": {
          "description": "Short artifact description.",
          "maxLength": 2000,
          "type": "string",
        },
        "expectedCurrentReleaseId": {
          "description": "Compare the current release atomically; null requires an unpublished artifact.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": [
            "string",
            "null",
          ],
        },
        "files": {
          "description": "Inline files (bytes travel through the model, inline budget); at least one of files/assets is required.",
          "items": {
            "additionalProperties": false,
            "oneOf": [
