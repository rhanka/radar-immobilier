{
  "name": "@radar/immo-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Read-only, mock-first MCP (stdio) provider exposing radar-immobilier domain tools (lots, signals, opportunities, documents) with an imposed auth context and anti-PII redaction.",
  "license": "UNLICENSED",
  "main": "./src/server.ts",
  "types": "./src/server.ts",
  "bin": {
    "immo-mcp": "./dist/server.js"
  },
  "exports": {
    ".": "./src/server.ts",
    "./tools": "./src/tools.ts",
    "./tool-definitions": "./src/tool-definitions.ts",
    "./tool-handlers": "./src/tool-handlers.ts",
    "./invocation-context": "./src/invocation-context.ts",
    "./auth-context": "./src/auth-context.ts",
    "./data-source": "./src/data-source.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "proof": "npm run build && tsx scripts/stdio-smoke.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radar/artifacts-host": "*",
    "@sentropic/artifacts": "0.2.2",
    "@sentropic/cluster-mesh": "0.22.1",
    "@sentropic/mcp-auth": "0.2.1",
    "@sentropic/oauth-verify": "^0.1.0",
    "hono": "^4.13.13",
    "jose": "^5.10.0",
    "pg": "^8.12.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "@types/node": "^25.0.0",
    "tsx": "^4.16.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
