{
  "schemaVersion": 1,
  "configVersion": "immo-artifacts.v1",
  "provider": {
    "id": "sentropic.artifacts",
    "version": "0.2.2",
    "selectionStatus": "guarded",
    "reason": "selected only with the shared 0.2.2 host, current activation, migrated coordinator and explicit durable quota"
  },
  "requiredContracts": {
    "capabilitySelection": "artifacts-profile/v1",
    "effectiveProfile": "immo-artifacts.v1",
    "durableCommandIdentity": "immo-artifacts.v1",
    "finalizationAuthorization": "artifacts-commit/v1",
    "typedFailure": "artifacts-outcome/v1"
  },
  "invocationScopes": { "read": "immo:artifacts:read", "write": "immo:artifacts:write" },
  "toolScopes": {
    "artifacts_ensure": "immo:artifacts:write",
    "artifacts_publish": "immo:artifacts:write",
    "artifacts_list": "immo:artifacts:read",
    "artifacts_get": "immo:artifacts:read"
  },
  "legacyReadTransition": {
    "flag": "IMMO_MCP_ARTIFACTS_LEGACY_READ_SCOPE",
    "default": false,
    "legacyScope": "immo:read",
    "appliesTo": ["artifacts_list", "artifacts_get"],
    "note": "Transition only: immo:read also satisfies the read tools; it never satisfies a write tool."
  },
  "selection": [
    { "tool": "artifacts_ensure", "operation": "ensure", "method": "POST", "path": "/ensure", "command": "ensure" },
    { "tool": "artifacts_publish", "operation": "publish", "method": "POST", "path": "/publish", "command": "publish" },
    { "tool": "artifacts_list", "operation": "list", "method": "POST", "path": "/list", "command": "list" },
    { "tool": "artifacts_get", "operation": "meta", "method": "GET", "path": "/meta/{artifactId}", "command": "meta" }
  ],
  "effectiveProfile": {
    "artifacts_ensure": {
      "required": ["bindingName", "idempotencyKey"],
      "bindingName": { "minLength": 1, "maxLength": 128 },
      "parameters": { "allowed": "empty-object-only" },
      "storageScope": "server-owned trusted configuration"
    },
    "artifacts_publish": {
      "required": ["artifactId", "files", "idempotencyKey"],
      "artifactId": "lowercase UUID validated by the library",
      "profile": { "shape": "flat primitive record", "default": {} },
      "provenance": { "fixed": "inline-original" },
      "files": {
        "minCount": 1,
        "maxCount": 32,
        "maxDecodedBytesPerFile": 262144,
        "maxDecodedBytesTotal": 262144,
        "entry": "path plus mimeType plus exactly one of text or bytes",
        "textEncoding": "UTF-8 bytes",
        "byteRange": "integers 0 through 255",
        "mimeTypes": ["text/html", "text/css", "text/javascript", "application/json"],
        "paths": "unique canonical paths; no empty or traversal segments, backslashes, percent-encoding, query or fragment markers",
        "reservedFirstSegments": ["api", "__artifacts", "livez", "health"]
      }
    },
    "artifacts_list": {
      "required": [],
      "limit": { "minimum": 1, "maximum": 100, "default": 20 },
      "offset": { "minimum": 0, "default": 0 },
      "note": "Authorization precedes pagination."
    },
    "artifacts_get": {
      "required": ["artifactId"],
      "artifactId": "lowercase UUID validated by the library"
    },
    "closedArguments": ["actor", "owner", "tenant", "storageScope", "internalIdempotencyKey", "paramsHash"],
    "callerKey": {
      "type": "string",
      "rule": "trimmed value is nonempty; original holds at most 256 UTF-16 code units and is preserved verbatim"
    }
  },
  "durableIdentity": {
    "internalKey": "SHA-256 UTF-8(storageScope | sub | operation | artifactIdOrEmpty | originalCallerKey)",
    "paramsHash": "effective command after scope binding, defaults, text-to-byte conversion and forced provenance; object keys sorted, array order significant",
    "conflict": "same key with changed effective content is a conflict and creates no new release",
    "payloadHashInKey": false
  },
  "activation": {
    "requiresFinalizationBinding": true,
    "requiresErrorBinding": true,
    "unselectedUntilQualified": true
  },
  "provenance": {
    "design": "conception-h4-v3",
    "section": "P3",
    "owner": "immo",
    "values": "non-secret identifiers and opaque references only"
  }
}
