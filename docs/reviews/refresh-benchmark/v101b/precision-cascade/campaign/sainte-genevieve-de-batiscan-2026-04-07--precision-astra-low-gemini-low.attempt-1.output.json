   "id": "constraint-reculs",
   "label": "Projet 509 — Reculs éoliens et restrictions d’implantation résidentielle",
   "node_type": "Constraint",
   "file_type": "document",
   "source_file": "raw/proces-verbaux-sainte-genevieve-de-batiscan/cas/2468693f7188b8ebae48472c0336489c31da03c711b3072bdfd598c0bb87ebf4.pdf",
   "status": "candidate",
   "constraintType": "autre",
   "municipality": "sainte-genevieve-de-batiscan",
   "meetingDate": "2026-04-07",
   "resolution": "26-04-04",
   "loi": "Premier projet 509-07-04-26, articles 17.9.4 à 17.9.8",
   "description": "Dispositions du premier projet, sans entrée en vigueur établie : recul éolien de 1 500 m des périmètres d’urbanisation et de 800 m des affectations résidentielles rurales; distance aux habitations d’au moins quatre fois la hauteur de l’éolienne; interdiction d’une nouvelle habitation à moins de 600 m et d’agrandir ou déplacer une habitation existante à moins de 550 m. Recul de 1 500 m de toute habitation lorsque l’éolienne est jumelée à un groupe électrogène diesel.",
   "citations": [
    {
     "page": 5,
     "excerpt": "Toute éolienne doit être située à au moins 1 500 mètres des limites de tout périmètre\nd’urbanisation.",
     "source_file": "raw/proces-verbaux-sainte-genevieve-de-batiscan/cas/2468693f7188b8ebae48472c0336489c31da03c711b3072bdfd598c0bb87ebf4.pdf",
     "rawRef": "raw/proces-verbaux-sainte-genevieve-de-batiscan/cas/2468693f7188b8ebae48472c0336489c31da03c711b3072bdfd598c0bb87ebf4.pdf",
     "docSha": "2468693f7188b8ebae48472c0336489c31da03c711b3072bdfd598c0bb87ebf4",
     "sourceUrl": "https://www.stegenevieve.ca/upload/seances-du-conseil/2026-04.pdf",
     "modality": "pdf"
    },
    {
     "page": 5,
     "excerpt": "La distance entre toute éolienne et toute habitation doit correspondre à au moins quatre\n(4) fois la hauteur de l’éolienne.",
     "source_file": "raw/proces-verbaux-sainte-genevieve-de-batiscan/cas/2468693f7188b8ebae48472c0336489c31da03c711b3072bdfd598c0bb87ebf4.pdf",
