    {"id":"astra-medium","model":"gpt-6-astra","effort":"medium","transport":"codex exec, siège ChatGPT, stdin, JSONL","concurrency":1},
    {"id":"sol-6.1-medium","model":"gpt-6.1-sol","effort":"medium","transport":"codex exec, siège ChatGPT, stdin, JSONL","concurrency":1},
    {"id":"opus-5.5-medium","model":"claude-opus-5-5","effort":"medium","transport":"claude -p, siège, stdin, JSON","concurrency":1},
    {"id":"gemini-4-argon-high","model":"gemini-4-argon-high","effort":"high","transport":"agy --print=, siège, stdin stream-json, slash désactivé","concurrency":1}
