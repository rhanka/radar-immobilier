{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "radar-artifact-content",
    "namespace": "radar-immobilier",
    "labels": { "app.kubernetes.io/name": "radar-immobilier", "app.kubernetes.io/component": "artifact-reader" },
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
      "traefik.ingress.kubernetes.io/router.tls": "true"
    }
  },
  "spec": {
    "ingressClassName": "traefik",
    "tls": [{ "hosts": ["*.pages.immo.sent-tech.ca"], "secretName": "radar-artifact-content-prod-tls" }],
    "rules": [{
      "host": "*.pages.immo.sent-tech.ca",
      "http": { "paths": [{ "path": "/", "pathType": "Prefix", "backend": {
        "service": { "name": "radar-api", "port": { "name": "http" } }
      } }] }
    }]
  }
}
