{
  "name": "radar-immobilier-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Automated municipal-document radar to detect residential densification opportunities in Québec.",
  "license": "UNLICENSED",
  "workspaces": [
    "api",
    "ui",
    "packages/*"
  ],
  "dependencies": {
    "@sentropic/artifacts": "0.2.22",
    "@sentropic/mcp-platform": "0.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "eslint": "^9.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@sentropic/artifacts": "$@sentropic/artifacts",
    "@sentropic/mcp-platform": "$@sentropic/mcp-platform",
    "svelte": "^5.0.0",
    "vite": "^6.4.4",
    "dompurify": "3.4.17",
    "@sentropic/geo-map-engine": {
      "@sentropic/geo-core": "0.6.1"
    },
    "@sentropic/geo-ui-svelte": {
      "@sentropic/geo-core": "0.6.1"
    },
    "maplibre-gl": "6.4.1",
    "officeparser": {
      "pdfjs-dist": "npm:empty-npm-package@1.0.0"
    },
    "@sentropic/engram": {
      "csv-parse": "7.0.3"
    },
    "@sentropic/design-system-svelte": "^0.35.1",
    "@ai-sdk/provider-utils@4.0.27": "4.0.33",
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:empty-npm-package@1.0.0"
    },
    "katex": "0.18.2"
  },
  "scripts": {
    "build:artifact": "node tools/make/ui-artifact-env.mjs npm run build -w ui",
    "data:polygons": "node --experimental-strip-types radar/data-prep/fetch-municipal-polygons.ts"
  },
  "allowScripts": {
    "@sentropic/engram": false,
    "esbuild": false,
    "fsevents": false,
    "tesseract.js": false,
    "tree-sitter-c": false,
    "tree-sitter-cpp": false,
    "tree-sitter-go": false,
    "tree-sitter-java": false,
    "tree-sitter-javascript": false,
    "tree-sitter-lua": false,
    "tree-sitter-php": false,
    "tree-sitter-python": false,
    "tree-sitter-ruby": false,
    "tree-sitter-rust": false,
    "tree-sitter-typescript": false
  }
}
